# Copy to .env and edit.  cp .env.example .env

# mock          = deterministic offline fakes that inject known failure modes.
#                 Use this for demos: guardrails fire against ground truth you
#                 control, and no API key or network is required.
# openai_compat = any OpenAI-compatible endpoint (OpenAI, Azure, Together,
#                 Groq, vLLM, Ollama, LiteLLM proxy...)
PROVIDER_MODE=mock

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# auto  = sentence-transformers if installed, else scikit-learn TF-IDF
# st    = force sentence-transformers
# tfidf = force the lightweight fallback (fastest cold start, no download)
EMBED_BACKEND=auto

# Stochastic samples per request, used for semantic-entropy and
# self-consistency. Higher = better uncertainty estimate, more cost. The
# pipeline automatically drops to 2 when the use case's latency budget is tight.
N_SAMPLES=4

# In production point this at a persistent volume, e.g.
# DB_PATH=/var/lib/controlplane/controlplane.db
# DB_PATH=./controlplane.db
